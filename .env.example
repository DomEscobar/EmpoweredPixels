# EmpoweredPixels Environment Configuration
# Copy this file to .env and update with your actual values
# NEVER commit .env to version control

# PostgreSQL Configuration
POSTGRES_DB=empoweredpixels
POSTGRES_USER=ep_user
POSTGRES_PASSWORD=CHANGE_THIS_TO_A_STRONG_PASSWORD_MIN_32_CHARS

# Backend API Configuration
EP_HTTP_ADDRESS=:54321

# Database URL (must match PostgreSQL credentials above)
# Format: postgres://<user>:<password>@<host>:<port>/<database>?sslmode=disable
EP_DATABASE_URL=postgres://ep_user:CHANGE_THIS_TO_A_STRONG_PASSWORD_MIN_32_CHARS@postgres-prod:5432/empoweredpixels?sslmode=disable

# JWT Secret for token signing (REQUIRED - minimum 32 characters, use a cryptographically strong value)
# Generate with: openssl rand -base64 32
EP_JWT_SECRET=CHANGE_THIS_TO_A_STRONG_32_CHAR_MINIMUM_SECRET_VALUE

# Engine Service URL (optional)
EP_ENGINE_URL=

# Frontend Configuration
VITE_API_BASE_URL=http://localhost:49101
